NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
BASE_DOMAIN=localhost
DATABASE_URL=mongodb://127.0.0.1:27019/dentalclinic?replicaSet=rs0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=DentaFlow <noreply@example.com>
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local development only; Vercel requires private S3 storage.
STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# At least 32 random characters; required for the authenticated cron endpoint.
CRON_SECRET=
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=
SEED_DEMO=false
